<?xml version="1.0" encoding="UTF-8"?>
<xs:schema id="ACTC602"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns:cat="http://www.cip-bancos.org.br/catalogomsg"
	targetNamespace="http://www.cip-bancos.org.br/ARQ/ACTC602.xsd"
	xmlns="http://www.cip-bancos.org.br/ARQ/ACTC602.xsd"
	elementFormDefault="qualified"
    version="1.11.0">

	<!-- Definição dos Tipos Globais -->
	<xs:include schemaLocation="ACTCTIPOS.xsd" />

	<!-- Definição do ACTCDOC -->
	<xs:complexType name="ACTCDOCComplexType">
		<xs:sequence>
			<xs:element name="BCARQ" type="BCARQComplexType" />
			<xs:element name="SISARQ" type="SISARQComplexType" />
			<xs:element name="ESTARQ" type="ESTARQSimpleType" minOccurs="0" />
		</xs:sequence>
	</xs:complexType>

	<!-- Definição do ACTCDOC -->
	<xs:element name="ACTCDOC" type="ACTCDOCComplexType">
		<xs:annotation>
			<xs:documentation>
			</xs:documentation>
		</xs:annotation>
	</xs:element>

	<!-- Definição do SISARQ -->
	<xs:complexType name="SISARQComplexType">
		<xs:choice>
			<xs:element name="ACTC602" type="ACTC602ComplexType">
				<xs:annotation>
					<xs:documentation>
						<cat:InfMensagem>
							<cat:Mensagem>
								CTC informa solicitação de transferência de contrato de cheque especial e/ou adiantamento a depositantes à Instituição
							</cat:Mensagem>
							<cat:Emissor>CTC</cat:Emissor>
							<cat:Destinatario>IF Credora Original</cat:Destinatario>
						</cat:InfMensagem>
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>

	<xs:complexType name="ACTC602ComplexType">
		<xs:sequence>
			<xs:element name="Grupo_ACTC602_Portldd" type="Grupo_ACTC602_PortlddComplexType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>
						Grupo Portabilidade
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="Grupo_ACTC602_PortlddComplexType">
		<xs:sequence>
			<xs:element name="IdentdPartAdmdo" type="CNPJBase">
				<xs:annotation>
					<xs:documentation>
						Identificador do participante administrado
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NUPortlddCTC" type="NU">
				<xs:annotation>
					<xs:documentation>
						<cat:InfCampo>
							<cat:DescricaoCampo>
								Número da portabilidade no CTC
							</cat:DescricaoCampo>
						</cat:InfCampo>
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IdentdIFPropnt" type="CNPJBase">
				<xs:annotation>
					<xs:documentation>
						<cat:InfCampo>
							<cat:DescricaoCampo>
								Identificador do solicitante da transferência
							</cat:DescricaoCampo>
						</cat:InfCampo>
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Grupo_ACTC602_IdentdContrto" type="Grupo_ACTC60X_IdentdContrtoComplexType">
				<xs:annotation>
					<xs:documentation>
						Grupo Identificador Contrato
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Grupo_ACTC602_Cli" type="Grupo_ACTC_CliComplexType_CodErro">
				<xs:annotation>
					<xs:documentation>
						Grupo Cliente
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Grupo_ACTC602_PropPortldd" type="Grupo_ACTC602_PropPortlddComplexType">
				<xs:annotation>
					<xs:documentation>
						Grupo Proposta Portabilidade
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Grupo_ACTC602_EndCartaPortldd" type="Grupo_EndCartaPortldd_ComplexType">
				<xs:annotation>
					<xs:documentation>
						Endereço Carta Portabilidade
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>