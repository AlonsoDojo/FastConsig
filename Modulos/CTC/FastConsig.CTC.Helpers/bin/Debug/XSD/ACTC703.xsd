	<!-- Definição dos Tipos Globais -->
	<xs:include schemaLocation="ACTCTIPOS.xsd" />

	<!-- Definição do ACTCDOC do arquivo -->
	<xs:complexType name="ACTCDOCComplexType">
		<xs:sequence>
			<xs:element name="BCARQ" type="BCARQComplexType" />
			<xs:element name="SISARQ" type="SISARQComplexType" />
			<xs:element name="ESTARQ" type="ESTARQSimpleType" minOccurs="0" />
		</xs:sequence>
	</xs:complexType>

	<!-- Definição do ACTCDOC -->
	<xs:element name="ACTCDOC" type="ACTCDOCComplexType">
		<xs:annotation>
			<xs:documentation>
			</xs:documentation>
		</xs:annotation>
	</xs:element>

	<!-- Definição do SISARQ -->
	<xs:complexType name="SISARQComplexType">
		<xs:choice>
			<xs:element name="ACTC703" type="ACTC703ComplexType">
				<xs:annotation>
					<xs:documentation>
						<cat:InfMensagem>
							<cat:Mensagem>
								Instituição credora original responde solicitação de transferência do contrato de cheque especial ao CTC
							</cat:Mensagem>
							<cat:Emissor>IF Credora Original</cat:Emissor>
							<cat:Destinatario>CTC</cat:Destinatario>
						</cat:InfMensagem>
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ACTC703RET" type="ACTC703RETComplexType">
				<xs:annotation>
					<xs:documentation>
						<cat:InfMensagem>
							<cat:Mensagem>
								CTC informa resposta de posição da portabilidade de contrato de crédito consignado</cat:Mensagem>
							<cat:Emissor>CTC</cat:Emissor>
							<cat:Destinatario>IF Credora Original</cat:Destinatario>
						</cat:InfMensagem>
					</xs:documentation>
				</xs:annotation>
			</xs:element>			
		</xs:choice>
	</xs:complexType>

	<xs:complexType name="ACTC703ComplexType">
		<xs:sequence>
			<xs:element name="Grupo_ACTC703_Portldd" type="Grupo_ACTC703_PortlddComplexType" maxOccurs="unbounded" />
		</xs:sequence>
	</xs:complexType>

