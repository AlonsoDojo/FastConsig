<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="ACTC923"
	xmlns="http://www.cip-bancos.org.br/ARQ/ACTC923.xsd"
	xmlns:xs="http://www.w3.org/2001/XMLSchema" 
	xmlns:cat="http://www.cip-bancos.org.br/catalogomsg"
	targetNamespace="http://www.cip-bancos.org.br/ARQ/ACTC923.xsd"
	elementFormDefault="qualified"
    version="1.11.0">
	
	<!-- Definição dos Tipos Globais -->
	<xs:include schemaLocation="ACTCTIPOS.xsd" />

	<!-- Definição do ACTCDOC do arquivo -->
	<xs:complexType name="ACTCDOCComplexType">
		<xs:sequence>
			<xs:element name="BCARQ" type="BCARQComplexType" />
			<xs:element name="SISARQ" type="SISARQComplexType" />
			<xs:element name="ESTARQ" type="ESTARQSimpleType" minOccurs="0" />
		</xs:sequence>
	</xs:complexType>
	
	<!-- Definição do ACTCDOC -->
	<xs:element name="ACTCDOC" type="ACTCDOCComplexType">
		<xs:annotation>
			<xs:documentation>
			</xs:documentation>
		</xs:annotation>
	</xs:element>	

	<!-- Definição do SISARQ do arquivo -->
	<xs:complexType name="SISARQComplexType">
		<xs:choice>
			<xs:element name="ACTC923" type="ACTC923ComplexType">
				<xs:annotation>
					<xs:documentation>
						<cat:InfMensagem>
							<cat:Mensagem>IF Solicita Relatório de Posição Analítica</cat:Mensagem>
							<cat:Emissor>IF Proponente/Credora Original</cat:Emissor>
							<cat:Destinatario>CTC</cat:Destinatario>
						</cat:InfMensagem>
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ACTC923RET" type="ACTC923RETComplexType">
				<xs:annotation>
					<xs:documentation>
						<cat:InfMensagem>
							<cat:Mensagem>CTC informa resultado da solicitação de Relatório de Posição Analítica</cat:Mensagem>
							<cat:Emissor>CTC</cat:Emissor>
							<cat:Destinatario>IF Proponente/Credora Original</cat:Destinatario>
						</cat:InfMensagem>
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>

	<xs:complexType name="ACTC923ComplexType">
		<xs:sequence>
			<xs:element name="IdentdPartAdmdo" type="CNPJBase">
				<xs:annotation>
					<xs:documentation>
						Identificador Participante Administrado 
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NumCtrlIF" type="ControleIF">
				<xs:annotation>
					<xs:documentation>
						Número Controle IF
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DtIniApurc" type="Data">
				<xs:annotation>
					<xs:documentation>
						Data Inicial da Apuração
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DtFimApurc" type="Data">
				<xs:annotation>
					<xs:documentation>
						Data Fim da Apuração
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ISPBPropnt" type="CNPJBase" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						ISPB Proponente 
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ISPBOrigdr" type="CNPJBase" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						ISPB Originador
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TpContrto" type="TpContrto" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Tipo Contrato 
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TpEnteCons" type="TpEnteCons" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Tipo de Ente Consignante
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SitPortlddCTC" type="SitPortlddCTC" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Situação Portabilidade CTC
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SitLiquidPortldd" type="SitLiquidPortldd" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Situação Portabilidade CTC
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="ACTC923RETComplexType">
		<xs:sequence>
			<xs:element name="Grupo_ACTC923RET_RelatPosAnlActo" type="Grupo_ACTC923RET_RelatPosAnlActoComplexType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
           				Grupo Relatório Posição Analítica Aceito
          			</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Grupo_ACTC923RET_RelatPosAnlRecsd" type="Grupo_ACTC923RET_RelatPosAnlRecsdComplexType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
		            	Grupo Relatório Posição Analítica Recusado
		          	</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="Grupo_ACTC923RET_RelatPosAnlActoComplexType">
	    <xs:sequence>
	    	<xs:element name="IdentdPartAdmdo" type="CNPJBase">
		        <xs:annotation>
		        	<xs:documentation>
		            	Identificador do participante administrado
		          	</xs:documentation>
		    	</xs:annotation>
		    </xs:element>
		    <xs:element name="NumCtrlIF" type="ControleIF">
		        <xs:annotation>
		        	<xs:documentation>
		            	Número Controle IF
		          	</xs:documentation>
		    	</xs:annotation>
		    </xs:element>
		    <xs:element name="NumCtrlCIP" type="ControleIF">
		        <xs:annotation>
		        	<xs:documentation>
		            	Número Controle CIP
		          	</xs:documentation>
		    	</xs:annotation>
		    </xs:element>
		    <xs:element name="DtSolictc" type="Data">
		        <xs:annotation>
		        	<xs:documentation>
		            	Data da Solicitação
		          	</xs:documentation>
		    	</xs:annotation>
		    </xs:element>
		    <xs:element name="SitSolictc" type="SitSolictc">
		        <xs:annotation>
		        	<xs:documentation>
		            	Situação da Solicitação
		          	</xs:documentation>
		    	</xs:annotation>
		    </xs:element>
	    </xs:sequence>
	</xs:complexType>

	<xs:complexType name="Grupo_ACTC923RET_RelatPosAnlRecsdComplexType">
		<xs:sequence>
	    	<xs:element name="IdentdPartAdmdo" type="CNPJBase_CodErro">
				<xs:annotation>
					<xs:documentation>
						Identificador Participante Administrado 
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NumCtrlIF" type="ControleIF_CodErro">
				<xs:annotation>
					<xs:documentation>
						Número Controle IF
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DtIniApurc" type="Data_CodErro">
				<xs:annotation>
					<xs:documentation>
						Data Inicial da Apuração
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DtFimApurc" type="Data_CodErro">
				<xs:annotation>
					<xs:documentation>
						Data Fim da Apuração
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ISPBPropnt" type="CNPJBase_CodErro" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						ISPB Proponente 
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ISPBOrigdr" type="CNPJBase_CodErro" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						ISPB Originador
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TpContrto" type="TpContrto_CodErro" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Tipo Contrato 
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TpEnteCons" type="TpEnteCons_CodErro" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Tipo de Ente Consignante
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SitPortlddCTC" type="SitPortlddCTC_CodErro" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Situação Portabilidade CTC
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SitLiquidPortldd" type="SitLiquidPortldd_CodErro" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Situação Portabilidade CTC
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="CodErro" type="CodErro" use="optional"/>
	</xs:complexType>
</xs:schema>