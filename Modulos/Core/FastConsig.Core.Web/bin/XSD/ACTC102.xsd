<?xml version="1.0" encoding="UTF-8"?>
<xs:schema id="ACTC102"
	xmlns:xs="http://www.w3.org/2001/XMLSchema" 
	xmlns:cat="http://www.cip-bancos.org.br/catalogomsg" 
	targetNamespace="http://www.cip-bancos.org.br/ARQ/ACTC102.xsd" 
	xmlns="http://www.cip-bancos.org.br/ARQ/ACTC102.xsd"
	elementFormDefault="qualified"
    version="1.11.0">
	
	<!-- Definição dos Tipos Globais -->
	<xs:include schemaLocation="ACTCTIPOS.xsd" />

	<!-- Definição do ACTCDOC -->
	<xs:complexType name="ACTCDOCComplexType">
		<xs:sequence>
			<xs:element name="BCARQ" type="BCARQComplexType" />
			<xs:element name="SISARQ" type="SISARQComplexType" />
			<xs:element name="ESTARQ" type="ESTARQSimpleType" minOccurs="0" />
		</xs:sequence>
	</xs:complexType>
	
	<!-- Definição do ACTCDOC -->
	<xs:element name="ACTCDOC" type="ACTCDOCComplexType">
		<xs:annotation>
			<xs:documentation>
			</xs:documentation>
		</xs:annotation>
	</xs:element>	

	<!-- Definição do SISARQ -->
	<xs:complexType name="SISARQComplexType">
		<xs:choice>
			<xs:element name="ACTC102" type="ACTC102ComplexType">
				<xs:annotation>
					<xs:documentation>
						<cat:InfMensagem>
							<cat:Mensagem>CTC informa solicitação de transferência de contrato de crédito consignado</cat:Mensagem>
							<cat:Emissor>CTC</cat:Emissor>
							<cat:Destinatario>IF Credora Original</cat:Destinatario>
						</cat:InfMensagem>
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>

	<xs:complexType name="ACTC102ComplexType">
		<xs:sequence>
      <xs:element name="Grupo_ACTC102_Portldd" type="Grupo_ACTC102_PortlddComplexType" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>
            Grupo Portabilidade
          </xs:documentation>
        </xs:annotation>
      </xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="Grupo_ACTC102_PortlddComplexType">
		<xs:sequence>
      <xs:element name="IdentdPartAdmdo" type="CNPJBase">
        <xs:annotation>
          <xs:documentation>
            Identificador do participante administrado
          </xs:documentation>
        </xs:annotation>
      </xs:element>
			<xs:element name="NUPortlddCTC" type="NU">
				<xs:annotation>
					<xs:documentation>
						<cat:InfCampo>
							<cat:DescricaoCampo>Número da portabilidade no CTC</cat:DescricaoCampo>
						</cat:InfCampo>
					</xs:documentation>
				</xs:annotation>
			</xs:element>		
			<xs:element name="IdentdIFPropnt" type="CNPJBase">
				<xs:annotation>
					<xs:documentation>
						<cat:InfCampo>
							<cat:DescricaoCampo>Identificador do solicitante da transferência</cat:DescricaoCampo>
						</cat:InfCampo>
					</xs:documentation>
				</xs:annotation>
			</xs:element>
      <xs:element name="Grupo_ACTC102_IdentdContrto" type="Grupo_ACTC10X_IdentdContrtoComplexType">
        <xs:annotation>
          <xs:documentation>
            Grupo Identificador Contrato
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Grupo_ACTC102_Cli" type="Grupo_ACTC_CliComplexType_CodErro">
        <xs:annotation>
          <xs:documentation>
            Grupo Cliente
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Grupo_ACTC102_PropPortldd" type="Grupo_ACTC102_PropPortlddComplexType">
        <xs:annotation>
          <xs:documentation>
            Grupo Proposta Portabilidade
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Grupo_ACTC102_EndCartaPortldd" type="Grupo_EndCartaPortldd_ComplexType">
        <xs:annotation>
          <xs:documentation>
            Endereço Carta Portabilidade
          </xs:documentation>
        </xs:annotation>
      </xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="Grupo_ACTC102_PropPortlddComplexType">
		<xs:sequence>
			<xs:element name="DtRefSaldDevdrContb" type="Data_CodErro">
				<xs:annotation>
					<xs:documentation>
						Data Referência Saldo Devedor Contábil para Proposta
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VlrSaldDevdrContb" type="Valor_CodErro">
				<xs:annotation>
					<xs:documentation>
						Valor Saldo Devedor Contábil para Proposta
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TxJurosNoml" type="Percentual_CodErro">
				<xs:annotation>
					<xs:documentation>
						Taxa Juros Nominal % a.a.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TxJurosEft" type="Percentual_CodErro">
				<xs:annotation>
					<xs:documentation>
						Taxa Juros Efetiva % a.a.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TxCET" type="Percentual_CodErro">
				<xs:annotation>
					<xs:documentation>
						Taxa CET
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CodMoeda" type="CodMoeda_CodErro">
				<xs:annotation>
					<xs:documentation>
						Código Moeda Contrato
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IndRemun" type="IndRemun_CodErro" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Índice Remuneração
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RegmAmtzc" type="RegmAmtzc_CodErro">
				<xs:annotation>
					<xs:documentation>
						Regime Amortização
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DtContrOp" type="Data_CodErro">
				<xs:annotation>
					<xs:documentation>
						Data Contratação Operação
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="QtdTotParclContrto" type="Qtd_CodErro">
				<xs:annotation>
					<xs:documentation>
						Quantidade Total Parcelas Contrato
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VlrFaceParclContrto" type="Valor_CodErro">
				<xs:annotation>
					<xs:documentation>
						Valor Face Parcelas Contrato
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DtVencPrimParclContrto" type="Data_CodErro">
				<xs:annotation>
					<xs:documentation>
						Data Vencimento Primeira Parcela Contrato
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DtVencUltParclContrto" type="Data_CodErro">
				<xs:annotation>
					<xs:documentation>
						Data Vencimento Última Parcela Contrato
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="CodErro" type="CodErro" use="optional" />
	</xs:complexType>

</xs:schema>