            <script type="text/javascript">
               function PostBackBlank(eventName) {
                  document.forms[0].target = '_blank';
                  document.forms[0].__EVENTTARGET.value = '__Page';
                  document.forms[0].__EVENTARGUMENT.value = eventName;
                  document.forms[0].submit();
                  document.forms[0].target = '';
               }
            </script>

            <script type="text/javascript">
               function doJQuery() {

                  // Form select styling
                  //$("form select.styled").select_skin();
               }

               $(function () {

                  doJQuery();

               });
            </script>

            <script type="text/javascript">
               function WindowOpen(url) {
                  window.open(url,
                     "Report",
                     "width=900,height=600,toolbar=no, location=center, directories=no, status=yes, menubar=no, scrollbars=yes,resizable=no,copyhistory=no")
               }

               function ScrollUp() {
                  var whereToMove = $("#topOfPage").position().top;
                  $("html,body").animate({ scrollTop: whereToMove }, 200);
               }

               function ScrollDown() {
                  var whereToMove = $("#bottomOfPage").position().top;
                  $("html,body").animate({ scrollTop: whereToMove }, 200);
               }
            </script>

            <script type="text/javascript">
               function ValidationSummaryOnSubmit(summary) {
                  var count = 0;
                  var status = true;
                  for (i = 0; i < Page_Validators.length; i++) {

                     if (!Page_Validators[i].isvalid) {

                        var contents = 'Existem campos com valores inválidos ou não preenchidos na tela, por favor verifique.';
                        ShowMessage(contents);
                        ScrollUp();

                        try {
                           $('#' + Page_Validators[i].id).empty();
                           $('#' + Page_Validators[i].id).append('<img src="/Imagens/erro_validacao.png"/>');
                           $('#' + Page_Validators[i].id).show();
                        } catch (e) { }

                        $(".alert").click(function () {
                           $(this).fadeOut('slow');
                        });

                        status = false;
                     } else {
                        try {
                           $('#' + Page_Validators[i].id).hide();
                        } catch (e) { }
                     }
                  }
                  try {
                     if (typeof ValidarPaginaJs != 'undefined' && $.isFunction(ValidarPaginaJs)) {
                        customStatus = ValidarPaginaJs();
                        if (!customStatus) {
                           ScrollUp();
                           status = customStatus;

                           ValidatorUpdateIsValid();
                        }
                     }
                  } catch (e) { }
                  return status;
               }

               function TelefoneCelular(event, element) {
                  if ($(element).val().length <= 13) {
                     var x = event.target.value.replace(/\D/g, '').match(/(\d{0,2})(\d{0,4})(\d{0,4})/);
                     event.target.value = !x[2] ? x[1] : '(' + x[1] + ') ' + x[2] + (x[3] ? '-' + x[3] : '');
                  }
                  else if ($(element).val().length == 14) {
                     var x = event.target.value.replace(/\D/g, '').match(/(\d{0,2})(\d{0,5})(\d{0,4})/);
                     event.target.value = !x[2] ? x[1] : '(' + x[1] + ') ' + x[2] + (x[3] ? '-' + x[3] : '');
                  }
               }

               function OnlyDigits(theEvent) {
                  var key = 0;
                  if (document.all) {
                     key = theEvent.keyCode;
                  } else {
                     key = theEvent.which;
                  }
                  return ((key > 47 && key < 58) ||
                     key == 8 || key == 127 ||
                     key == 0 || key == 9 || key == 13);
               }

               function ShowMessage(contents) {
                  var div = $('<div class="alert alert-danger alert-dismissible">' + contents + '</div>');
                  $('#msg').empty();
                  $('#msg').append(div);
               }

               function GenericFormat(theEvent, theMask) {
                  var field, content, i, size, key, character, digitNumber;

                  if (document.all) { // Internet Explorer   
                     field = theEvent.srcElement;
                     key = theEvent.keyCode;
                  } else { // Nestcape, Mozzila   
                     field = theEvent.target;
                     key = theEvent.which;
                  }

                  if (key == 8) return true;

                  content = field.value;
                  size = content.length;
                  digitNumber = theMask.replace(/\D/g, "");

                  for (i = 0; i < theMask.length; i++) {
                     character = theMask.charAt(i);
                     if (character != "9") {
                        if (i <= size & character != content.charAt(i)) {
                           field.value = content.substring(0, i) + character + content.substring(i, size);
                        }
                     }
                  }
                  return false;
               }

               function ScrollUp() {
                  var whereToMove = $("#topOfPage").position().top;
                  $("html,body").animate({ scrollTop: whereToMove }, 200);
               }

               function ScrollDown() {
                  var whereToMove = $("#bottomOfPage").position().top;
                  $("html,body").animate({ scrollTop: whereToMove }, 200);
               }

               function OpenNewWindow(url) {
                  var win = window.open(url, '_blank');
                  if (win) {
                     win.focus();
                  } else {
                     ShowMessage('Por favor, configure seu browser para permitir abrir janelas popups deste site.');
                  }
               }

               Sys.Browser.WebKit = {}; //Safari 3 is considered WebKit
               if (navigator.userAgent.indexOf('WebKit/') > -1) {
                  Sys.Browser.agent = Sys.Browser.WebKit;
                  Sys.Browser.version = parseFloat(navigator.userAgent.match(/WebKit\/(\d+(\.\d+)?)/)[1]);
                  Sys.Browser.name = 'WebKit';
               }

               var prm = Sys.WebForms.PageRequestManager.getInstance();
               prm.add_endRequest(function () {
                  StartupJs();
               });

               $(document).ready(function () {
                  StartupJs();
               });

               function StartupJs() {
                  Waves.init();
                  (jQuery);
                  $.getScript('/scripts/functions.js');

                  if (localStorage) {
                     var menuStateCollapsed = localStorage.getItem('__SideBar_Collapssed__');
                     var container = $('div.page-container');
                     if (menuStateCollapsed == 'false' || menuStateCollapsed === null) {
                        container.removeClass('sidebar-collapsed');
                        container.removeClass('can-resize');
                     }
                     else {
                        var window_width = $(window).outerWidth();
                        if (window_width < 951 && window_width > 767) {
                           if (container.hasClass('can-resize') === false) {
                              container.addClass('sidebar-collapsed');
                           }
                        } else if (window_width < 767) {
                           container.removeClass('sidebar-collapsed');
                           container.removeClass('can-resize');
                        }
                        else {
                           //if (container.hasClass('can-resize') === false) {
                           container.addClass('sidebar-collapsed');
                           container.addClass('can-resize');
                           //}
                        }
                     }
                  }

                  $("input.format-decimal8").priceFormat({
                     allowNegative: true,
                     prefix: '',
                     centsSeparator: ',',
                     thousandsSeparator: '.',
                     limit: 18,
                     centsLimit: 0
                  });

                  $("input.format-decimal-18-2").priceFormat({
                     allowNegative: true,
                     prefix: '',
                     centsSeparator: ',',
                     thousandsSeparator: '.',
                     limit: 18,
                     centsLimit: 2
                  });

                  $("input.format-decimal-18-4").priceFormat({
                     allowNegative: true,
                     prefix: '',
                     centsSeparator: ',',
                     thousandsSeparator: '.',
                     limit: 18,
                     centsLimit: 4
                  });

                  $("input.format-decimal-18-6").priceFormat({
                     allowNegative: true,
                     prefix: '',
                     centsSeparator: ',',
                     thousandsSeparator: '.',
                     limit: 18,
                     centsLimit: 6
                  });

                  $("input.format-percent").priceFormat({
                     allowNegative: true,
                     prefix: '',
                     centsSeparator: ',',
                     thousandsSeparator: '.',
                     limit: 5,
                     centsLimit: 2
                  });

                  $(window).scroll(function () {
                     var height = $(window).scrollTop();
                     if (height > 450) {
                        $('#back2Top').fadeIn();
                     } else {
                        $('#back2Top').fadeOut();
                     }

                     if ($(window).scrollTop() + $(window).height() < $(document).height() - 450) {
                        if ($("#back2Down").length)
                           $('#back2Down').fadeIn();
                     } else {
                        if ($("#back2Down").length)
                           $('#back2Down').fadeOut();
                     }
                  });

                  $("#back2Top").click(function (event) {
                     event.preventDefault();
                     ScrollUp();
                     return false;
                  });

                  $(document).ready(function () {
                     $('.select2').select2();
                  });

                  if ($("#back2Down").length) {
                     $("#back2Down").click(function (event) {
                        event.preventDefault();
                        ScrollDown();
                        return false;
                     });
                  }

                  if (typeof StartupPaginaJs != 'undefined' && $.isFunction(StartupPaginaJs)) {
                     StartupPaginaJs();
                  }

                  //Procura todos objetos que contenha o atribuido de ValidarFormulario=true para ser realizada a validaï¿½ï¿½o do formulï¿½rio.
                  $("*[ValidarFormulario='true'],*[ValidarFormulario='True']").click(function (event) {

                     // Quem está executando a ação é um Modal?
                     var isModal = new Boolean($('#' + event.target.id).attr('IsModal'));

                     if (!ValidarFormulario(isModal)) {
                        event.preventDefault();
                     }
                  });

                  //Confirmação Exclusão.
                  $("*[DialogConfirmarExclusao='true'],*[DialogConfirmarExclusao='True']").click(function (e) {
                     e.preventDefault();
                     DialogConfirmarExclusao(e);
                  });

                  //Confirmação da Ação.
                  $("*[DialogConfirmarAcao='true'],*[DialogConfirmarAcao='True']").click(function (e) {
                     e.preventDefault();
                     DialogConfirmarAcao(e);
                  });
               }

               /*
                    Validar formulário usando o mesmo padrão visual que o Framework.Web 
                */
               function ValidarFormulario(isModal) {

                  var count = 0;
                  var hasModal = false;
                  var msgErroValidacao = 'Existem campos com valores inválidos ou não preenchidos na tela, por favor verifique!';

                  //Procurando todos fiels que contenha o atributo obrigatorio=true.
                  $("*[obrigatorio='true'],*[Obrigatorio='True']").each(function (index) {

                     //input text and dropdownlist
                     if ($(this).val() == "" ||
                        $(this).val() == null ||
                        $(this).val().toLowerCase() == "selecione".toLowerCase() ||
                        $(this).val().toLowerCase() == "(selecione)".toLowerCase()) {

                        // verificando se o objeto atual da iteração não tem o atributo IsModal.
                        // Pode ser que quem está executando a ação não seja um Modal, porém na iteração encotrou um obj que é modal, por isso a validação abaixo
                        hasModal = new Boolean($(this).attr('IsModal'));

                        IdModal = $(this).attr('IdModal');

                        if (isModal && ($('#' + IdModal).data('bs.modal') || {}).isShown) //Se for Modal e estiver aberto contabiliza (Ou seja campo obrigatorio esta em branco)
                           count++;
                        else if (isModal == false && hasModal == false) //Se não for Modal ou seja é formulario padrão contabliza
                           count++;

                        //Verificando se o Div que contém o objeto da iteração do loop tem a imagem de erro validação.
                        if ($(this).parent()[0].innerHTML.indexOf('img src="/Imagens/erro_validacao.png') == -1) {

                           if (isModal == false) {
                              if (count > 0) {
                                 $(this).parent().append('<span style="display: inline;" runat="server"><img src="/Imagens/erro_validacao.png"></span>');
                                 ShowMessage(msgErroValidacao);
                              }
                           }
                           else {

                              if ($("#" + IdModal).css('display') == 'block') {
                                 if (count > 0) {
                                    $(this).parent().append('<span style="display: inline;" runat="server"><img src="/Imagens/erro_validacao.png"></span>');
                                    ShowMessageModal(msgErroValidacao);
                                 }
                              }
                           }
                        }
                     }
                     else {
                        //Verificando se o Div que cont&#65533;m o objeto da iteração do loop tem a imagem de erro validação, caso contenha será removida.
                        if ($(this).parent()[0].innerHTML.indexOf('img src="/Imagens/erro_validacao.png') != -1) {
                           $(this).parent().find('img').remove();
                        }
                     }
                  });

                  if (count > 0)
                     return false;
                  else
                     return true;
               }

               function ShowMessageModal(contents) {
                  var div = $('<div class="alert alert-danger alert-dismissible">' + contents + '</div>');
                  $('.modalValidacao').empty();
                  $('.modalValidacao').append(div);
               }

               //Confirmação Exclusão.
               function DialogConfirmarExclusao(event) {

                  var objPostBack = event.currentTarget.href.substring(event.currentTarget.href.indexOf('WebForm_PostBackOptions(') + 25);
                  objPostBack = objPostBack.substring(0, objPostBack.indexOf('"'));
                  BootstrapDialog.confirm({
                     title: 'Exclusão',
                     message: 'Deseja realmente excluir este item?',
                     type: BootstrapDialog.TYPE_PRIMARY, // <-- Default value is BootstrapDialog.TYPE_PRIMARY
                     closable: true, // <-- Default value is false
                     draggable: true, // <-- Default value is false
                     btnCancelLabel: 'Não', // <-- Default value is 'Cancel',
                     btnOKLabel: 'Sim', // <-- Default value is 'OK',
                     btnOKClass: 'btn-default', // <-- If you didn't specify it, dialog type will be used,
                     callback: function (result) {
                        if (result)
                           DoPostBackManual(objPostBack);
                     }
                  });

                  return false;
               }

               //Confirmação da Ação.
               function DialogConfirmarAcao(event) {

                  var objPostBack = event.currentTarget.href.substring(event.currentTarget.href.indexOf('WebForm_PostBackOptions(') + 25);
                  objPostBack = objPostBack.substring(0, objPostBack.indexOf('"'));
                  BootstrapDialog.confirm({
                     title: 'Confirmação',
                     message: 'Deseja realmente executar esta ação?',
                     type: BootstrapDialog.TYPE_PRIMARY, // <-- Default value is BootstrapDialog.TYPE_PRIMARY
                     closable: true, // <-- Default value is false
                     draggable: true, // <-- Default value is false
                     btnCancelLabel: 'Não', // <-- Default value is 'Cancel',
                     btnOKLabel: 'Sim', // <-- Default value is 'OK',
                     btnOKClass: 'btn-default', // <-- If you didn't specify it, dialog type will be used,
                     callback: function (result) {
                        if (result)
                           DoPostBackManual(objPostBack);
                     }
                  });

                  return false;
               }

               function DoPostBackManual(obj) {
                  WebForm_DoPostBackWithOptions(new WebForm_PostBackOptions(obj, "", true, "", "", false, true));
               }


            </script>

            <script type="text/javascript">
               function SessionExpireAlert(timeout) {
                  var seconds = timeout / 1000;
                  document.getElementsByName("secondsIdle").innerHTML = seconds;
                  setInterval(function () {
                     seconds--;
                     document.getElementById("seconds").innerHTML = seconds;
                     document.getElementById("secondsIdle").innerHTML = sec2time(seconds);
                  }, 1000);
                  setTimeout(function () { }, timeout - 60 * 1000);
                  setTimeout(function () { window.location = "Login.aspx"; }, timeout);
               };
               function ResetSession() {
                  //Redirect to refresh Session.
                  window.location = window.location.href;
               }

               function sec2time(timeInSeconds) {
                  var pad = function (num, size) { return ('000' + num).slice(size * -1); },
                     time = parseFloat(timeInSeconds).toFixed(3),
                     hours = Math.floor(time / 60 / 60),
                     minutes = Math.floor(time / 60) % 60,
                     seconds = Math.floor(time - minutes * 60),
                     milliseconds = time.slice(-3);

                  return pad(hours, 2) + ':' + pad(minutes, 2) + ':' + pad(seconds, 2);
               }
            </script>

         </ContentTemplate>
      </asp:UpdatePanel>
   </form>
</body>
</html>
