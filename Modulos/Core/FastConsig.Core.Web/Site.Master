   <!-- Responsive datatable examples -->
   <link href="/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css">
   <!-- Buttons -->
   <link href="/css/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css">
